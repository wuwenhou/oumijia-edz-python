# Get API_ID and API_HASH from https://my.telegram.org (never paste login codes in chat)
API_ID=
API_HASH=
# Recommended: Telegram numeric chat IDs (-100...). Public @usernames also work.
SOURCE_CHAT=
DEST_CHAT=
# Optional: allows login to prefill phone, not needed for service runtime
TELEGRAM_PHONE=
# Change to false ONLY after validating target channel and permissions.
DRY_RUN=true
# Generated per-part EDZ is NOT proven EPLAN-import compatible. Default HOLD.
ALLOW_UNVERIFIED_SPLITS=false
# If false, do not run automatic backfill. Use --backfill once first.
BACKFILL_ON_START=true
# 24/7 file watcher; no automatic deletion of source archive or EDZ output
DATA_DIR=./data
EDZSPLIT_BIN=./vendor/edzsplit/edzsplit
SEVEN_ZIP=7z
DISK_RESERVE_GB=10
MAX_ARCHIVE_FILES=100000
MAX_UNPACK_GB=150
MAX_UPLOAD_GB=2
VOLUME_QUIET_SECONDS=600
POLL_SECONDS=30
SEND_DELAY_SECONDS=3
# Backfill rate limit / status output
LOG_LEVEL=INFO
# V12 fully automatic mode (opt in only, requires DRY_RUN=false)
AUTO_MODE=false
# v16.3 continuous downloader/processor/publisher; OFF until explicitly activated.
EDZ_CONTINUOUS_PIPELINE=false
EDZ_PIPELINE_MAX_ACTIVE_SOURCES=2
EDZ_PIPELINE_MAX_READY_ARTIFACTS=4000
EDZ_PIPELINE_MAX_READY_GIB=16
# Error notifications go to Telegram Saved Messages of this account.
# A numeric chat ID may be used instead; do not use the destination data channel.
ERROR_CHAT=me
AUTO_CLEANUP=false
AUTO_WORK_CLEANUP=false
AUTO_PLAN_QUEUE=false
MAX_GROUP_GIB=60

# OUMIJIA v16 — một nhóm riêng để điều khiển, gửi file và nhận cảnh báo
# Để trống EDZ_INBOX_CHAT cho đến khi đã tạo nhóm và đặt admin ID.
EDZ_INBOX_CHAT=
EDZ_INBOX_USER_IDS=
EDZ_NOTIFY_BOT_TOKEN=
# Không cần EDZ_NOTIFY_CHAT_ID; thông báo vào EDZ_INBOX_CHAT.

# Compatibility guard: live legacy source scan is OFF by default.
# Control group (EDZ_INBOX_CHAT) and local catalog intake are unaffected.
EDZ_SOURCE_SCAN_ENABLED=false
